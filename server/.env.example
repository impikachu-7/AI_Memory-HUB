APP_ENV=development
DATABASE_URL=postgresql+psycopg://memoryhub:memoryhub@localhost:5432/memoryhub
JWT_SECRET=replace-with-a-32-character-minimum-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
OTP_PEPPER=replace-with-a-separate-long-random-secret
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
FRONTEND_ORIGINS=http://localhost:5173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
CHROMA_PATH=./data/chroma
MEMORY_RETRIEVAL_LIMIT=8
LOG_LEVEL=INFO

